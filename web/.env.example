# Copy this file to .env.development or .env.production and fill in real values.
# .env.* files are gitignored — never commit secrets.

VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Get from analytics.google.com → Admin → Data Streams → your stream
# Leave as G-PLACEHOLDER until you have a real property — GA4 won't load.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
